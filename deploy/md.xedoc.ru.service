[Unit]
Description=md.xedoc.ru markdown sharing service
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/md.xedoc.ru
EnvironmentFile=/var/www/md.xedoc.ru/.env
ExecStart=/usr/bin/node /var/www/md.xedoc.ru/dist/src/server.js
Restart=always
RestartSec=5
User=www-data
Group=www-data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/md.xedoc.ru/data

[Install]
WantedBy=multi-user.target
